doctype html
html(lang="ru")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    title Универсальный веб-скрапер
    link(rel="stylesheet" href="/css/output.css")
    script(src="https://cdn.jsdelivr.net/npm/marked/marked.min.js")
  
  body.bg-gray-100
    .container.mx-auto.px-4.py-8
      h1.text-3xl.font-bold.mb-6 Универсальный веб-скрапер
      .form-container.mb-6
        div(class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4")
          .relative
            input#urlInput(
              class="w-full px-4 py-2 border rounded-lg pr-8"
              type="url" 
              placeholder="Введите URL сайта" 
              required
            )
            button#clearUrl(
              class="absolute right-2 top-1/2 -translate-y-1/2 text-gray-400 hover:text-gray-600"
              type="button"
            ) ×
          .flex.gap-4.items-end
            label(for="linksLimit" class="flex flex-col")
              span.text-xs.text-gray-600.mb-1 Кол-во ссылок
              input#linksLimit(
                class="w-32 px-4 py-2 border rounded-lg"
                type="number"
                placeholder="Ссылки"
                value="10"
                min="1"
                max="100"
              )
            label(for="imagesLimit" class="flex flex-col")
              span.text-xs.text-gray-600.mb-1 Кол-во картинок
              input#imagesLimit(
                class="w-32 px-4 py-2 border rounded-lg"
                type="number"
                placeholder="Картинки"
                value="10"
                min="1"
                max="50"
              )
            label(for="headingsLimit" class="flex flex-col")
              span.text-xs.text-gray-600.mb-1 Кол-во заголовков
              input#headingsLimit(
                class="w-32 px-4 py-2 border rounded-lg"
                type="number"
                placeholder="Заголовки"
                value="10"
                min="1"
                max="50"
              )
            button#resetInputs(
              class="bg-red-500 hover:bg-red-600 text-white px-4 py-2 rounded-lg"
              type="button"
            ) Сброс
        .flex.gap-4.items-center
          button(
            class="bg-green-500 hover:bg-green-600 text-white px-6 py-2 rounded-lg"
            onclick="startScraping()"
          ) Начать скрапинг
          button#resetInputs(
            class="bg-red-500 hover:bg-red-600 text-white px-6 py-2 rounded-lg"
            type="button"
          ) Сброс
          select#dataType(
            class="px-4 py-2 border rounded-lg"
          )
            option(value="all") Все данные
            option(value="links") Только ссылки
            option(value="images") Только картинки
            option(value="headings") Только заголовки
            option(value="metadata") Только метаданные
      
      #result(class="bg-white rounded-lg shadow-lg p-6")

    script(src="/js/main.js")